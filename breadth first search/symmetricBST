# Given a binary tree t, determine whether it is symmetric around its center, i.e. each side mirrors the other.

# Binary trees are already defined with this interface:
# class Tree(object):
#   def __init__(self, x):
#     self.value = x
#     self.left = None
#     self.right = None
def solution(t):
    
    queue = []
    levels = []
    level = 0
    queue.append(t)
    
    while queue:
        length = len(queue)
        levels.append([])
        for i in range(0,length):
            val = queue.pop(0)
            if not val:
                levels[level].append(val)
            else:
                levels[level].append(val.value)
                
                if val.left:
                    queue.append(val.left)
                else:
                    queue.append(None)
                if val.right:
                    queue.append(val.right)
                else:
                    queue.append(None)
        if levels[level] != levels[level][::-1]:
            return False
        level +=1
    return True
